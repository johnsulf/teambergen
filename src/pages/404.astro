---
import Layout from '../layouts/Layout.astro';
import Footer from '../layouts/components/Footer.astro';
import Header from '../layouts/components/Header.astro';
---

<Layout
  title="Siden finnes ikke | Team Bergen?"
  description="Beklager, vi fant ikke siden du lette etter. Gå tilbake til forsiden for å finne det du søker."
>
  <Header />
  <main class="grow flex items-center justify-center hero-gradient bg-noise">
    <section class="py-20 text-center relative z-10">
      <div class="container mx-auto px-4 max-w-2xl">
        <div class="text-9xl mb-8">🥏</div>
        <h1 class="mb-4 text-primary-content">Oi, griplock!</h1>
        <p class="text-xl text-primary-content/70 mb-10">
          Siden du lette etter er OB!
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="/" class="btn btn-accent btn-lg">Til forsiden</a>
          <a
            href="/team"
            class="btn btn-ghost btn-lg text-primary-content/80 hover:text-accent"
            >Møt teamet</a
          >
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
