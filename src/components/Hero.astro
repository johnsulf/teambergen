---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
---

<section
  class="hero-gradient bg-noise min-h-[90vh] flex items-center relative overflow-hidden"
>
  <!-- Decorative blurred orbs -->
  <div class="absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-1/4 -right-32 w-125 h-125 rounded-full bg-accent/10 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-20 w-96 h-96 rounded-full bg-secondary/15 blur-3xl"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div
      class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-20"
    >
      <!-- Text content – left aligned for editorial feel -->
      <div class="flex-1 text-center lg:text-left">
        <h1 class="animate-fade-up stagger-1 text-primary-content">
          Team Bergen?
        </h1>
        <p
          class="text-sm text-primary-content/50 mt-2 animate-fade-up stagger-1 font-medium tracking-wide uppercase"
        >
          Ja, med spørsmålstegn!
        </p>

        <p
          class="text-lg md:text-xl text-primary-content/80 max-w-xl mt-6 leading-relaxed animate-fade-up stagger-2 lg:mr-auto"
        >
          Diskgolfteam fra Bergen og Vestlandet. Vi er en gjeng entusiaster som
          vil litt mer med sporten vår – både på og utenfor banen.
        </p>

        <!-- CTA buttons -->
        <div
          class="flex gap-4 justify-center lg:justify-start flex-wrap mt-10 animate-fade-up stagger-3"
        >
          <a href="/team" class="btn btn-accent btn-lg gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
            Møt teamet
          </a>
          <a
            href="/kontakt#sponsor"
            class="btn btn-ghost btn-lg text-primary-content/80 hover:text-primary-content hover:bg-primary-content/15 gap-2 group"
          >
            Bli sponsor
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Visual element – overlapping, off-grid, kinetic -->
      <div
        class="shrink-0 w-72 h-72 md:w-96 md:h-96 relative animate-fade-up stagger-2 hidden md:block"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0 rounded-2xl bg-linear-to-br from-accent/20 to-secondary/20 rotate-6"
        >
        </div>
        <div
          class="absolute inset-4 rounded-xl bg-primary-content/25 backdrop-blur-sm -rotate-3 flex items-center justify-center p-8"
        >
          <Image
            src={logo}
            alt=""
            class="w-full h-full object-contain drop-shadow-2xl"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce text-primary-content/40"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>
