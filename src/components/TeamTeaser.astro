---
import { getCollection } from 'astro:content';
import PlayerAvatar from './PlayerAvatar.astro';

const allMembers = await getCollection('team');
const teamMembers = allMembers.sort((a, b) => a.data.order - b.data.order);
---

<section class="section-padding bg-base-200 relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Asymmetric header – left aligned -->
    <div class="max-w-5xl mb-14 md:mb-20">
      <h2 class="mb-4 animate-fade-up">Møt folkene i Team Bergen?</h2>
      <p class="lead max-w-xl animate-fade-up stagger-1">
        Fire spillere med ulik bakgrunn, men felles mål: å bli bedre og ha det
        gøy med diskgolf.
      </p>
    </div>

    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-5 md:gap-8 max-w-5xl mx-auto"
    >
      {
        teamMembers.map((member, index) => (
          <a
            href={`/team#${member.id}`}
            class={`group relative animate-fade-up stagger-${index + 1}`}
          >
            <div class="overflow-hidden rounded-xl">
              <PlayerAvatar name={member.data.name} />
            </div>
            <div class="mt-4">
              <h3 class="text-base md:text-lg font-medium tracking-tight">
                {member.data.name.split(' ')[0]}
              </h3>
              <span class="text-sm text-base-content/60">
                {member.data.role}
              </span>
            </div>
            {/* Overlapping accent chip */}
            <div class="absolute -top-2 -right-2 md:-top-3 md:-right-3 w-8 h-8 md:w-10 md:h-10 rounded-full bg-accent flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-lg">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 md:h-5 md:w-5 text-accent-content"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 animate-fade-up stagger-4">
      <a href="/team" class="btn btn-accent gap-2">
        Les mer om spillerne
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
