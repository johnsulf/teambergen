---
interface ContactItem {
  icon: 'email' | 'instagram' | 'youtube' | 'snapchat' | 'tiktok';
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  title?: string;
  items: ContactItem[];
}

const { title = 'Kontakt', items } = Astro.props;

const icons: Record<string, string> = {
  email:
    'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  instagram: '', // SVG will be inline
  youtube: '', // SVG will be inline
  snapchat: '', // SVG will be inline
  tiktok: '', // SVG will be inline
};
---

<div class="card bg-base-200">
  <div class="card-body">
    <h3 class="card-title mb-4">{title}</h3>
    <ul class="space-y-3">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center gap-3 p-3 rounded-xl bg-base-100 hover:bg-accent/5 transition-colors group"
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <span class="w-10 h-10 rounded-2xl bg-primary/10 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
                {item.icon === 'email' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={icons.email}
                    />
                  </svg>
                )}
                {item.icon === 'instagram' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-primary"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
                )}
                {item.icon === 'youtube' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-primary"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
                {item.icon === 'snapchat' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-primary"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.12.922-.214.14-.05.272-.094.39-.12.26-.06.483-.076.647-.076.296 0 .559.076.756.229.272.209.39.544.343.901-.075.579-.54 1.067-1.362 1.411-.06.03-.12.044-.181.06-.497.149-1.186.253-1.394.508-.15.196-.06.497.09.795.661 1.277 1.563 2.395 2.7 3.22.333.24.663.39.973.494.06.015.12.045.18.06.33.12.555.3.645.555.105.3-.075.659-.405.9-.468.332-1.11.525-1.888.704-.093.023-.168.075-.198.135-.045.09-.06.21-.075.33-.015.12-.03.255-.06.39-.03.135-.09.27-.18.39-.195.255-.51.39-.87.39-.21 0-.434-.03-.644-.06-.375-.06-.795-.12-1.28-.12-.27 0-.54.03-.81.06-.75.12-1.395.735-2.279 1.59-.3.285-.615.585-.96.855-.345.27-.735.48-1.14.48-.405 0-.795-.21-1.14-.48-.345-.27-.66-.57-.96-.855-.884-.855-1.53-1.47-2.28-1.59-.27-.03-.54-.06-.81-.06-.484 0-.905.06-1.28.12-.21.03-.435.06-.645.06-.36 0-.675-.135-.87-.39-.09-.12-.15-.255-.18-.39-.03-.135-.045-.27-.06-.39-.015-.12-.03-.24-.075-.33-.03-.06-.105-.112-.198-.135-.779-.18-1.42-.372-1.888-.704-.33-.24-.51-.6-.406-.9.09-.255.315-.435.646-.555.06-.015.12-.045.18-.06.31-.105.64-.255.973-.494 1.137-.825 2.04-1.943 2.7-3.22.15-.298.24-.599.09-.795-.208-.255-.897-.36-1.394-.508-.06-.016-.12-.03-.18-.06-.823-.345-1.288-.832-1.363-1.411-.047-.357.07-.692.344-.901.196-.153.46-.229.756-.229.164 0 .387.015.647.076.118.026.25.07.39.12.263.094.622.214.922.214.198 0 .326-.045.401-.09-.008-.165-.018-.33-.03-.51l-.003-.06c-.104-1.628-.23-3.654.3-4.847C7.86 1.069 11.216.793 12.206.793z" />
                  </svg>
                )}
                {item.icon === 'tiktok' && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-primary"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
                  </svg>
                )}
              </span>
              <span class="font-medium">{item.label}</span>
              {item.external && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 ml-auto opacity-50"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
