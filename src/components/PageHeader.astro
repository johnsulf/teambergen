---
interface Props {
  title: string;
  lead?: string;
  centered?: boolean;
}

const { title, lead, centered = false } = Astro.props;
---

<header class="page-header hero-gradient bg-noise relative overflow-hidden">
  <!-- Decorative blurred orbs -->
  <div class="absolute inset-0" aria-hidden="true">
    <div
      class="absolute top-1/4 -right-32 w-100 h-100 rounded-full bg-accent/10 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-secondary/15 blur-3xl"
    >
    </div>
  </div>

  <div
    class="container mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 relative z-10"
  >
    <div class={`max-w-4xl ${centered ? 'mx-auto text-center' : ''}`}>
      <h1 class="animate-fade-up mb-4 text-primary-content">{title}</h1>
      {
        lead && (
          <p
            class={`text-lg md:text-xl text-primary-content/75 max-w-2xl animate-fade-up stagger-1 leading-relaxed ${centered ? 'mx-auto' : ''}`}
          >
            {lead}
          </p>
        )
      }
      <slot />
    </div>
  </div>
</header>

<style>
  .page-header {
    min-height: 40vh;
    display: flex;
    align-items: center;
  }
</style>
