---
const stats = [
  { value: '4', label: 'Spillere' },
  { value: '3', label: 'Sponsorer' },
  { value: '10+', label: 'Turneringer' },
  { value: '1', label: 'Region' },
];
---

<section class="bg-team-teal bg-noise relative overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-team-gold/5 blur-3xl"
    >
    </div>
  </div>
  <div
    class="container mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 relative z-10"
  >
    <div
      class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12"
    >
      {
        stats.map((stat) => (
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-bold text-team-gold mb-2 tracking-tight">
              {stat.value}
            </p>
            <p class="text-sm text-white/70 font-medium tracking-wide uppercase">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
